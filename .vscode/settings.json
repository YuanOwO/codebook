{
    "editor.rulers": [60, 72, 120],
    "editor.tabSize": 2,
    "C_Cpp.default.includePath": ["${workspaceFolder}/include/**"],
    "C_Cpp.default.defines": ["${myDefines}", "_DEBUG", "UNICODE", "_UNICODE", "SHIKA"],
    "C_Cpp.default.forcedInclude": ["${workspaceFolder}/include/global.h"],
    "C_Cpp.default.compilerArgs": ["-O1", "-O2", "-O3", "-Wall", "-Wextra", "-Wshadow"],
    "files.associations": {
        "*.tcc": "cpp",
        "algorithm": "cpp",
        "bitset": "cpp",
        "chrono": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "string": "cpp",
        "rope": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "slist": "cpp",
        "system_error": "cpp",
        "valarray": "cpp",
        "__locale": "cpp",
        "memory": "cpp",
        "optional": "cpp",
        "string_view": "cpp",
        "variant": "cpp"
    },
    "latex-workshop.latex.recipe.default": "xelatex",
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex",
            "tools": ["xelatex"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "latexmk",
            "args": ["-xelatex", "-interaction=nonstopmode", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
        }
    ],
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "onSucceeded",
    "latex-workshop.latex.clean.fileTypes": [
        "%DOCFILE%.aux",
        "%DOCFILE%.bbl",
        "%DOCFILE%.blg",
        "%DOCFILE%.idx",
        "%DOCFILE%.ind",
        "%DOCFILE%.lof",
        "%DOCFILE%.lot",
        "%DOCFILE%.out",
        "%DOCFILE%.toc",
        "%DOCFILE%.acn",
        "%DOCFILE%.acr",
        "%DOCFILE%.alg",
        "%DOCFILE%.glg",
        "%DOCFILE%.glo",
        "%DOCFILE%.gls",
        "%DOCFILE%.fls",
        // "%DOCFILE%.log",
        "%DOCFILE%.fdb_latexmk",
        "%DOCFILE%.snm",
        "%DOCFILE%.synctex(busy)",
        "%DOCFILE%.synctex.gz(busy)",
        "%DOCFILE%.nav",
        "%DOCFILE%.vrb"
    ],
    "latex-workshop.formatting.latex": "latexindent"
}
